[Unit]
Description=Doobee GitHub App
After=network.target

[Service]
Type=simple
User=doobee
Group=doobee
WorkingDirectory=/home/doobee/doobee
ExecStart=/home/doobee/.bun/bin/bun run dev
Restart=on-failure
RestartSec=5

# Bun auto-loads .env from WorkingDirectory
# claude CLI lives in ~/.bun/bin — must be on PATH for Bun.spawn
Environment=HOME=/home/doobee
Environment=PATH=/home/doobee/.bun/bin:/home/doobee/.local/share/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
